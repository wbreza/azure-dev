# Ignore Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.

###############################
# OS-specific files
###############################
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
.Trash-*

###############################
# Visual Studio specific
###############################
# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific folders
.vscode/
.vs/
.vscode/

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Uncomment if you have tasks to ignore
# .vscode/tasks.json

# Include if you have deploy files
# .deploy/

# Uncomment if you have to avoid test-assets:
# test/_TestAsset/dlls/

# Changelog appended file:
.changelog

###############################
# Docker
###############################
.dockerignore

# Backup of visual workspace for mobile dev `don't migrate` logs:
[Oo]utdated (contentonly|logs|Mobile
